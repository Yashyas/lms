# ==============================================================================
# Full Monorepo .gitignore (NestJS + Next.js + ZenStack + Tools)
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# Build Outputs & Compilation Artifacts
# ------------------------------------------------------------------------------
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts
.vercel/
.cache/
.parcel-cache/

# ------------------------------------------------------------------------------
# Python Environments & Caches (Graphify, QA Scripts, CLI tools)
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.*.example

# Credentials & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# QA, Swarm & Audit Suite (Local Only - Excluded from Git)
# ------------------------------------------------------------------------------
# Tooling scripts, test suite, and runners
scripts/
tests/
tools/
qa.config*.json

# QA Plugins & Agent Rules
.agents/plugins/
.agents/rules/qa-audit-safety.md
.agents/.qa-backup*
.agents/backup*

# Swarm reports, dashboards & registers
reports/
reports/**
audit-summary.html
audit-summary*.html
*-report.html
*-report.json
*.report.*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Test Coverage & Results
coverage/
.nyc_output/
*.lcov
playwright-report/
test-results/
blob-report/

# ------------------------------------------------------------------------------
# AI Agent Skills & Lockfiles (Excluded from Git)
# ------------------------------------------------------------------------------
# Companion skills, local skills, and lockfiles
.agents/skills/
.agent/skills/
skills/
skills-lock.json
.skills-lock.json

# ------------------------------------------------------------------------------
# Knowledge Graph & Benchmark Data
# ------------------------------------------------------------------------------
graphify-out/
load-test/

# ------------------------------------------------------------------------------
# Logs & Runtime Process Files
# ------------------------------------------------------------------------------
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock
.temp/
.tmp/
tmp/

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# IDEs & Editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# VSCode (allow shared configurations if any)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
