datasource db {
    provider = 'postgresql'
    url = env('DATABASE_URL')
    directUrl = env('DIRECT_URL')
}

plugin policy {
    provider = "@zenstackhq/plugin-policy"
}

/// User model
model User {
    id            String    @id @default(cuid())
    email         String    @unique @email @length(6, 255)
    name          String
    emailVerified Boolean   @default(false)
    image         String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @default(now()) @updatedAt
    sessions      Session[]
    accounts      Account[]
    role          String?
    banned        Boolean?  @default(false)
    banReason     String?
    banExpires    DateTime?

    coursesTaught Course[]  @relation("InstructorCourses")
    enrollments   Enrollment[]

    @@allow('read',true)
    @@allow('update', auth().id == id || auth().role == 'admin')
    @@allow('all', auth().role == 'admin')

    @@map('user')
}

model Session {
    id             String   @id
    expiresAt      DateTime
    token          String   @unique
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    ipAddress      String?
    userAgent      String?
    userId         String
    user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    impersonatedBy String?

    @@allow('all',auth().id == userId || auth().role == 'admin')
    @@map('session')
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@allow('all', auth().id == userId || auth().role == 'admin')
    @@map('account')
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @default(now()) @updatedAt

    @@map('verification')
}

model Course {
    id          String      @id @default(cuid())
    title       String      @length(3, 256)
    slug        String      @unique
    description String?    
    price       Int         @default(0) //stored in paise/INR
    published   Boolean     @default(false)
    instructorId String     @default(auth().id)
    instructor   User       @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)
    lessons      Lesson[]
    enrollments  Enrollment[]
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt

    @@allow('read',published || auth().id == instructorId || auth().role == 'admin')
    @@allow('create', auth().role == 'instructor' || auth().role == 'admin')
    @@allow('update,delete', auth().id == instructorId || auth().role == 'admin')
    
    @@map('course')
}

model Lesson {
    id         String    @id @default(cuid())
    title      String    @length(1,256)
    content    String?
    videoUrl   String?
    position   Int        @default(0)
    isFree     Boolean    @default(false)
    courseId   String
    course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt

    @@allow('read', isFree || course.instructorId == auth().id || auth().role == 'admin' || course.enrollments?[userId == auth().id])
    @@allow('create,update,delete', course.instructorId == auth().id || auth().role == 'admin')

    @@map('lesson')
}

model Enrollment {
    id          String      @id @default(cuid())
    userId      String      @default(auth().id)
    user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    courseId    String      
    course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
    createdAt   DateTime    @default(now())

    @@unique([userId, courseId])
    @@allow('read,create', auth().id == userId || auth().role == 'admin')
    @@allow('read', course.instructorId == auth().id)
    @@allow('delete',auth().role == 'admin')
    @@map('enrollment')

}