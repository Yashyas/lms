datasource db {
    provider = 'postgresql'
    url = env('DATABASE_URL')
    directUrl = env('DIRECT_URL')
}

plugin policy {
    provider = "@zenstackhq/plugin-policy"
}

/// User model
model User {
    id            String    @id @default(cuid())
    email         String    @unique @email @length(6, 255)
    name          String
    emailVerified Boolean   @default(false) @allow('update', auth().role == 'admin')
    headline      String?   @length(0, 256)
    bio           String?   @length(0, 2048)
    image         String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @default(now()) @updatedAt
    sessions      Session[]
    accounts      Account[]
    role          String?   @allow('update', auth().role == 'admin')
    banned        Boolean?  @default(false) @allow('update', auth().role == 'admin')
    banReason     String?   @allow('update', auth().role == 'admin')
    banExpires    DateTime? @allow('update', auth().role == 'admin')

    payments      Payment[]
    coursesTaught Course[]  @relation("InstructorCourses")
    enrollments   Enrollment[]
    lessonProgress LessonProgress[]

    @@allow('read',true)
    @@allow('update', auth().id == id || auth().role == 'admin')
    @@allow('all', auth().role == 'admin')

    @@map('user')
}

model Session {
    id             String   @id
    expiresAt      DateTime
    token          String   @unique
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    ipAddress      String?
    userAgent      String?
    userId         String
    user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    impersonatedBy String?

    @@allow('all',auth().id == userId || auth().role == 'admin')
    @@index([userId])
    @@map('session')
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@allow('all', auth().id == userId || auth().role == 'admin')
    @@index([userId])
    @@map('account')
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @default(now()) @updatedAt

    @@map('verification')
}

model Course {
    id          String      @id @default(cuid())
    title       String      @length(3, 256)
    slug        String      @unique
    description String?   
    thumbnail   String? 
    price       Int         @default(0) //stored in paise/INR
    published   Boolean     @default(false)
    instructorId String     @default(auth().id)
    instructor   User       @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)
    lessons      Lesson[]
    enrollments  Enrollment[]
    payments     Payment[]
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt

    @@allow('read',published || auth().id == instructorId || auth().role == 'admin')
    @@allow('create', auth().role == 'instructor' || auth().role == 'admin')
    @@allow('update,delete', auth().id == instructorId || auth().role == 'admin')
    
    @@index([published])
    @@index([instructorId])
    @@map('course')
}

model Lesson {
    id         String    @id @default(cuid())
    title      String    @length(1,256)
    content    String?
    videoUrl   String?
    position   Int        @default(0)
    isFree     Boolean    @default(false)
    courseId   String
    course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt
    videoAsset VideoAsset?
    lessonProgress LessonProgress[]

    @@allow('read', isFree || course.instructorId == auth().id || auth().role == 'admin' || course.enrollments?[userId == auth().id])
    @@allow('create,update,delete', course.instructorId == auth().id || auth().role == 'admin')

    @@index([courseId])
    @@index([courseId, position])
    @@map('lesson')
}

enum VideoStatus {
    PENDING_UPLOAD
    PROCESSING
    READY
    FAILED
}

model VideoAsset {
    id                  String          @id @default(cuid())
    status              VideoStatus     @default(PENDING_UPLOAD)
    lessonId            String          @unique
    lesson              Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
    rawStorageKey       String?
    hlsMasterUrl        String?
    durationSeconds     Int             @default(0)
    encryptionKey       String?
    encryptionIv        String?
    errorMessage        String?
    createdAt           DateTime        @default(now())
    updatedAt           DateTime        @updatedAt

    
    @@allow('all', auth().id == lesson.course.instructorId || auth().role == 'admin')

    @@map('video_asset')
}

model Enrollment {
    id          String      @id @default(cuid())
    userId      String      @default(auth().id)
    user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    courseId    String      
    course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
    createdAt   DateTime    @default(now())

    payment     Payment?

    @@unique([userId, courseId])
    @@index([courseId])
    @@index([userId, createdAt])
    @@allow('create', (auth().id == userId && course.price == 0) || auth().role == 'admin')
    @@allow('read', auth().id == userId || course.instructorId == auth().id || auth().role == 'admin')
    @@allow('delete', auth().id == userId || auth().role == 'admin')
    @@map('enrollment')

}

model LessonProgress {
    id                  String      @id @default(cuid())
    userId              String      @default(auth().id)
    user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    lessonId            String
    lesson              Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
    lastPlayedSeconds   Int         @default(0)
    completed           Boolean     @default(false)
    completedAt         DateTime?   
    createdAt           DateTime    @default(now())
    updatedAt           DateTime    @updatedAt

    @@allow('read,create,update', auth().id == userId || auth().role == 'admin')
    @@allow('read', lesson.course.instructorId == auth().id)


    @@unique([userId, lessonId])
    @@map('lesson_progress')
}

enum PaymentStatus {
    PENDING
    COMPLETED
    FAILED
    REFUNDED
}

model Payment {
    id                    String          @id @default(cuid())
    userId                String?         
    user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
    
    courseId              String?
    course                Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
    
    enrollmentId          String?         @unique
    enrollment            Enrollment?     @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

    userEmail             String          //email of user buying course
    courseTitle           String          //title at the time of buying course


    price                 Int             // stored in cents/paise
    currency              String          @default("usd")
    status                PaymentStatus   @default(PENDING)
    provider              String          @default("stripe")
    stripeSessionId       String?         @unique
    stripePaymentIntentId String?         @unique
   
    createdAt             DateTime        @default(now())
    updatedAt             DateTime        @updatedAt
   
    @@allow('read', (userId != null && auth().id == userId) || (course != null && course.instructorId == auth().id) || auth().role == 'admin')
    @@allow('all', auth().role == 'admin')
    @@index([userId])
    @@index([courseId])
    @@index([stripeSessionId])
   

    @@map('payment')
}